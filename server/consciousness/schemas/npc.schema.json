{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flappyjournal.dev/schema/game/npc.json",
  "title": "NPC",
  "type": "object",
  "required": ["id", "name", "archetype"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "archetype": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1 },
    "mood": { "type": "string" },
    "faction": { "type": "string" },
    "memoryKeys": { "type": "array", "items": { "type": "string" } },
    "stats": {
      "type": "object",
      "properties": {
        "hp": { "type": "integer", "minimum": 0 },
        "atk": { "type": "integer", "minimum": 0 },
        "def": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sigil": { "type": "string" },
        "hash": { "type": "string" },
        "origin": {
          "type": "object",
          "properties": {
            "world": { "type": "string" },
            "shard": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

